# Copy to .env and fill in real secrets. .env is gitignored.
POSTGRES_USER=sauron
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sauron
MINIO_ROOT_USER=sauron
MINIO_ROOT_PASSWORD=change-me-too
EVENTS_BUCKET=sauron-events
# Auth (JWT). SECRET_KEY: openssl rand -hex 32
AUTH_ENABLED=true
SECRET_KEY=change-me-secret
ADMIN_EMAIL=admin@sauron.local
ADMIN_PASSWORD=change-me-admin
INGEST_TOKEN=change-me-ingest
# DeepStream sizing/tuning (XS defaults)
DEEPSTREAM_MAX_STREAMS=20
DEEPSTREAM_SECONDARY_BATCH=64
DEEPSTREAM_TARGET_FPS=10
DEEPSTREAM_INFERENCE_INTERVAL=0
# Optional
# APP_NAME=Sauron
# COMPANY_NAME=
# BRAND_PRIMARY_COLOR=#0E7C66
# S3_PUBLIC_ENDPOINT=localhost:8080
# Web Push (PWA) - generar con: python api/src/sauron_api/tools_vapid.py
SAURON_VAPID_PRIVATE_KEY=
SAURON_VAPID_PUBLIC_KEY=
# Retención de evidencia (días; 0 = sin retención)
RETENTION_DAYS=90
S3_RETENTION_DAYS=90
# SSO OIDC (MS365 / Google Workspace). JSON:
# {"microsoft": {"issuer": "https://login.microsoftonline.com/<tenant>/v2.0", "client_id": "...", "client_secret": "..."},
#  "google": {"issuer": "https://accounts.google.com", "client_id": "...", "client_secret": "..."}}
OIDC_PROVIDERS_JSON=
OIDC_REDIRECT_BASE=http://localhost:8080
OIDC_ALLOWED_DOMAINS=
