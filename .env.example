# Copy to .env and fill in real secrets. .env is gitignored.
POSTGRES_USER=sauron
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sauron
MINIO_ROOT_USER=sauron
MINIO_ROOT_PASSWORD=change-me-too
EVENTS_BUCKET=sauron-events
# Auth (JWT). SECRET_KEY: openssl rand -hex 32
AUTH_ENABLED=true
SECRET_KEY=change-me-secret
ADMIN_EMAIL=admin@sauron.local
ADMIN_PASSWORD=change-me-admin
INGEST_TOKEN=change-me-ingest
# DeepStream sizing/tuning (XS defaults)
DEEPSTREAM_MAX_STREAMS=20
DEEPSTREAM_SECONDARY_BATCH=64
DEEPSTREAM_TARGET_FPS=10
DEEPSTREAM_INFERENCE_INTERVAL=0
# Evidencia: clip de 5 s previos + 10 s posteriores, buffer codificado local
EVIDENCE_ENABLED=true
EVIDENCE_PRE_SECONDS=5
EVIDENCE_POST_SECONDS=10
EVIDENCE_RETENTION_SECONDS=120
# FastALPR (profile: alpr). GPU 0 is validated with ONNX Runtime on Robotito.
ALPR_GPU_DEVICE=0
ALPR_PORT=8091
ALPR_TARGET_FPS=4
# Sincronización con Cámaras: perfil "matriculas" entra, cambio/eliminación sale (segundos)
ALPR_RECONCILE_S=15
# Región fija para eventos ALPR (el guess del OCR global suele errar)
ALPR_REGION=CL
# Best-shot: espera a que el vehículo se acerque y emite la mejor lectura
ALPR_BESTSHOT_WAIT_S=4
ALPR_BESTSHOT_CONF=0.95
# Regla: solo publicar lecturas cuya placa exista en el Registro Civil
ALPR_VALIDATE_PLATE=false
# Consultar datos vehiculares solo con certeza máxima (YOLO + OCR)
ALPR_QUERY_DET_CONF=1.0
ALPR_QUERY_OCR_CONF=1.0
ALPR_STALE_AFTER_S=30
# camera_id=go2rtc_source permits HD/transcoded aliases.
ALPR_STREAMS=cam-10,cam-166=cam-166-hd,cam-196,cam-212,cam-39=cam-39-hd,cam-75,caltrans-i5-43rd=public-i5-43rd,caltrans-us50-howe=public-us50-howe
ALPR_DETECTOR_CONFIDENCE=0.25
ALPR_OCR_CONFIDENCE=0.65
# Proxy /alpr/ de la web: base64 de usuario:contraseña del servicio ALPR
# (printf '%s' 'admin@sauron.local:contraseña' | base64)
ALPR_BASIC_TOKEN=
# Datos vehiculares por patente (Boostr). API KEY gratuita en https://api.boostr.cl/patente
ALPR_VEHICLE_API_URL=https://api.boostr.cl/vehicle/{plate}.json
# Proveedor: vacío = desactivado | demo = datos sintéticos | boostr = REST | matriculaapi = SOAP regcheck
ALPR_VEHICLE_PROVIDER=
# matriculaapi (regcheck.org.uk): SOLO se envía la patente; filtrar por cámara(s)
ALPR_VEHICLE_CAMERAS=
ALPR_MATRICULA_USERNAME=
ALPR_MATRICULA_KEY=
ALPR_MATRICULA_ENDPOINT=https://www.regcheck.org.uk/api/reg.asmx
ALPR_VEHICLE_API_KEY=
# Incluir propietario (nombre/RUT) en los eventos; falso por privacidad
ALPR_VEHICLE_INCLUDE_OWNER=false
# Optional
# APP_NAME=Sauron
# COMPANY_NAME=
# BRAND_PRIMARY_COLOR=#0E7C66
# WEB_PORT=8080
# S3_PUBLIC_ENDPOINT=localhost:8080
# Web Push (PWA) - generar con: python api/src/sauron_api/tools_vapid.py
SAURON_VAPID_PRIVATE_KEY=
SAURON_VAPID_PUBLIC_KEY=
# Retención de evidencia (días; 0 = sin retención)
RETENTION_DAYS=90
S3_RETENTION_DAYS=90
# SSO OIDC (MS365 / Google Workspace). JSON:
# {"microsoft": {"issuer": "https://login.microsoftonline.com/<tenant>/v2.0", "client_id": "...", "client_secret": "..."},
#  "google": {"issuer": "https://accounts.google.com", "client_id": "...", "client_secret": "..."}}
OIDC_PROVIDERS_JSON=
OIDC_REDIRECT_BASE=http://localhost:8080
OIDC_ALLOWED_DOMAINS=

# Optional
# APP_NAME=Sauron
# COMPANY_NAME=
# BRAND_PRIMARY_COLOR=#0E7C66
# WEB_PORT=8080
# S3_PUBLIC_ENDPOINT=localhost:8080
# Web Push (PWA) - generar con: python api/src/sauron_api/tools_vapid.py
SAURON_VAPID_PRIVATE_KEY=
SAURON_VAPID_PUBLIC_KEY=
# Retención de evidencia (días; 0 = sin retención)
RETENTION_DAYS=90
S3_RETENTION_DAYS=90
# SSO OIDC (MS365 / Google Workspace). JSON:
# {"microsoft": {"issuer": "https://login.microsoftonline.com/<tenant>/v2.0", "client_id": "...", "client_secret": "..."},
#  "google": {"issuer": "https://accounts.google.com", "client_id": "...", "client_secret": "..."}}
OIDC_PROVIDERS_JSON=
OIDC_REDIRECT_BASE=http://localhost:8080
OIDC_ALLOWED_DOMAINS=
